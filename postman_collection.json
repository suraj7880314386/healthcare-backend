            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mehta\",\n  \"specialization\": \"Cardiology\",\n  \"email\": \"mehta@example.com\",\n  \"phone\": \"9123456780\",\n  \"experience\": 10\n}"
            }
          }
        },
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/doctors/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            }
          }
        },
        {
          "name": "Get doctor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/doctors/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doctors",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update doctor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/doctors/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doctors",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mehta\",\n  \"specialization\": \"Neurology\",\n  \"email\": \"mehta@example.com\",\n  \"phone\": \"9123456780\",\n  \"experience\": 12\n}"
            }
          }
        },
        {
          "name": "Delete doctor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/api/doctors/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doctors",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Mappings",
      "item": [
        {
          "name": "Assign doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/mappings/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": 1,\n  \"doctor\": 1\n}"
            }
          }
        },
        {
          "name": "List mappings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/mappings/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "mappings"
              ]
            }
          }
        },
        {
          "name": "Doctors of a patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/mappings/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "mappings",
                "1"
              ]
            }
          }
        },
        {
          "name": "Remove mapping",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/api/mappings/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "mappings",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}