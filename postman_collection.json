{
  "info": {
    "name": "Healthcare Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/register/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suraj Singh\",\n  \"email\": \"suraj@example.com\",\n  \"password\": \"Strong@12345\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"suraj@example.com\",\n  \"password\": \"Strong@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.access) { pm.collectionVariables.set('token', d.access); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Add patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/patients/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"age\": 30,\n  \"gender\": \"M\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Delhi\"\n}"
            }
          }
        },
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/patients/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            }
          }
        },
        {
          "name": "Get patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/patients/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/patients/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"age\": 31,\n  \"gender\": \"M\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Noida\"\n}"
            }
          }
        },
        {
          "name": "Delete patient",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/api/patients/1/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Add doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
